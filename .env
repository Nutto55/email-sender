## SMTP configuration for Mailpit or any other SMTP server. Update the values below with your SMTP server details.
NUXT_SMTP_HOST=localhost
NUXT_SMTP_PORT=1025
NUXT_SMTP_FROM=noreply@example.com

## For authentication, uncomment the following lines and provide your SMTP username and password
# NUXT_SMTP_USERNAME=
# NUXT_SMTP_PASSWORD=
